# git cli shortcuts
alias gs='git status'
alias gits='gs'

alias gc='git commit -m'
alias gitc='gc'

alias gps='git push'
alias gitps='gps'
alias gpf='git push --force-with-lease'
alias gitpf='gpf'

alias gpl='git pull'
alias gitpl='gpl'

alias gco='git checkout'
alias gitco='gco'

alias gbr='git branch -a'
alias gitbr='gbr'

alias grb='git rebase origin/main'

alias greset='git reset --hard && git checkout main && git pull'

# adds specified files then displays status
function ga {
    git add $@ && git status
}

function gac {
    ga . && gc $@ && gps
}
